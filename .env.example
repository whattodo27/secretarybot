# --- Telegram ---
BOT_TOKEN=123456789:replace-me

# --- SQLite ---
# Where the DB file lives (inside the container, mounted as a volume).
DATA_DIR=data
DB_FILE=bot.db

# --- LLM (OpenAI-compatible) ---
# Point at any OpenAI-compatible API. Defaults work with OpenRouter.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-replace-me
LLM_MODEL=deepseek/deepseek-chat

# --- Scheduler ---
# How often (seconds) the bot checks for due reminders.
POLL_INTERVAL_SEC=15
# A reminder within this many hours counts as "upcoming" (vs "later").
UPCOMING_WINDOW_H=24